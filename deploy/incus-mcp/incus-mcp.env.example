# /etc/incus-mcp/incus-mcp.env — read by the incus-mcp systemd service.
# Address and port the MCP server listens on (the container's LAN address).
INCUS_MCP_LISTEN_HOST=192.168.1.50
INCUS_MCP_LISTEN_PORT=8444
# HTTPS for the MCP clients (certificate signed by the local CA, SAN = the address above).
INCUS_MCP_TLS_CERT=/etc/incus-mcp/tls.crt
INCUS_MCP_TLS_KEY=/etc/incus-mcp/tls.key
# Bearer token expected from clients (48 random characters, 0640 root:incus-mcp).
INCUS_MCP_TOKEN_FILE=/etc/incus-mcp/token
# Client addresses accepted (comma-separated CIDRs). Everything else gets 403.
INCUS_MCP_ALLOWED_NETWORKS=192.168.1.0/24
# Incus API, reached through the "incus-api" proxy device of this container.
INCUS_MCP_INCUS_URL=https://127.0.0.1:8443
INCUS_MCP_CLIENT_CERT=/etc/incus-mcp/client.crt
INCUS_MCP_CLIENT_KEY=/etc/incus-mcp/client.key
# Pinned Incus server certificate (copy of /var/lib/incus/server.crt from the host).
INCUS_MCP_SERVER_CERT=/etc/incus-mcp/server.crt
# The only Incus project this server may touch. Never "default".
INCUS_MCP_PROJECT=timon
INCUS_MCP_IMAGE_SERVER=https://images.linuxcontainers.org
INCUS_MCP_AUDIT_LOG=/var/log/incus-mcp/audit.log
INCUS_MCP_EXEC_TIMEOUT=120
INCUS_MCP_OUTPUT_LIMIT=65536
INCUS_MCP_LOG_LEVEL=info
