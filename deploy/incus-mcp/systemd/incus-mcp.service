[Unit]
Description=incus-mcp: MCP server for the restricted Incus project
Documentation=file:///opt/incus-mcp/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=incus-mcp
Group=incus-mcp
EnvironmentFile=/etc/incus-mcp/incus-mcp.env
ExecStartPre=/opt/incus-mcp/venv/bin/incus-mcp check
ExecStart=/opt/incus-mcp/venv/bin/incus-mcp
Restart=on-failure
RestartSec=5

# Hardening: the service only reads /etc/incus-mcp and appends to its audit log.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/var/log/incus-mcp

[Install]
WantedBy=multi-user.target
